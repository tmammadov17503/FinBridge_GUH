# FinBridge frontend — server-side configuration.
#
# Copy to `.env.local` and fill in. Everything here is read only inside src/routes/api/*,
# so none of it is bundled into browser JavaScript. Do not prefix any of these with VITE_:
# that WOULD expose them to the browser.

# ---------------------------------------------------------------- n8n agent

# Base URL of the n8n instance running the FinBridge workflows.
# No trailing slash, and no /webhook suffix — that is added for you.
N8N_BASE_URL=https://your-instance.app.n8n.cloud

# Use /webhook-test instead while a workflow is pinned open in the n8n editor.
# N8N_WEBHOOK_PATH=/webhook

# Optional header auth, if the webhooks are locked down (they should be before any
# public demo — see the "Status" section of the root README).
# N8N_WEBHOOK_AUTH_HEADER=x-finbridge-key
# N8N_WEBHOOK_AUTH_VALUE=

# -------------------------------------------------------------- elevenlabs

# Create at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional overrides. The default voice is Lily (British English); the client can only
# request one of the names in ALLOWED_VOICES in src/lib/finbridge/server-config.ts.
# ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
